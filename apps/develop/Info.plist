<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Extra keys merged into Omina Develop.app's Info.plist when it is packaged. -->
<plist version="1.0">
<dict>
    <!-- Omina Develop projects (.omid): this app's own file type, so Finder shows them as "Omina Develop Project" with
         the omid-document icon (assets/icon, made by scripts/make-document-icon.py) and double-clicking
         one opens it here. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.oddomens.omina-develop.project</string>
            <key>UTTypeDescription</key>
            <string>Omina Develop Project</string>
            <key>UTTypeIconFile</key>
            <string>omid-document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>omid</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-omina-develop</string>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.oddomens.develop.project</string>
            <key>UTTypeDescription</key>
            <string>Omina Develop Project (older)</string>
            <key>UTTypeIconFile</key>
            <string>omid-document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>develop</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-omina-develop</string>
            </dict>
        </dict>
    </array>
    <!-- Projects saved before .omid (.develop) still open here, with the same icon. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Omina Develop Project</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleTypeIconFile</key>
            <string>omid-document</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.oddomens.omina-develop.project</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Omina Develop Project (older)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleTypeIconFile</key>
            <string>omid-document</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.oddomens.develop.project</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
